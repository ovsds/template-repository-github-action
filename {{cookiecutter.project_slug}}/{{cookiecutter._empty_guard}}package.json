{
  "private": true,
  "name": "{{cookiecutter.project_slug}}",
{%- if cookiecutter.action_type == 'node' %}
  "main": "lib/main.js",
  "dependencies": {
    "@actions/core": "3.0.1"
  },
{%- endif %}
  "devDependencies": {
{%- if cookiecutter.action_type == 'node' %}
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "vitest": "^5.0.5",
{%- endif %}
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "hooks": {
    "pre-commit": "lint-staged",
    "commit-msg": "commitlint"
  },
  "lint-staged": {
{%- if cookiecutter.action_type == 'node' %}
    "*.{ts,tsx}": [
      "prettier --check",
      "eslint"
    ],
{%- endif %}
{%- if cookiecutter.with_shellcheck == 'true' %}
    "*.sh": [
      "shellcheck"
    ],
{%- endif %}
    "*.{md,yaml,json,js}": [
      "prettier --check"
    ]
  },
  "scripts": {
    "lint:check": "npm run lint:check:prettier{% if cookiecutter.action_type == 'node' %} && npm run lint:check:eslint{% endif %}{% if cookiecutter.with_shellcheck == 'true' %} && npm run lint:check:shellcheck{% endif %}",
{%- if cookiecutter.action_type == 'node' %}
    "lint:check:eslint": "eslint .",
{%- endif %}
    "lint:check:prettier": "prettier --check .",
{%- if cookiecutter.with_shellcheck == 'true' %}
    "lint:check:shellcheck": "shellcheck **/*.sh --enable=all",
{%- endif %}
    "lint:fix": "npm run lint:fix:prettier{% if cookiecutter.action_type == 'node' %} && npm run lint:fix:eslint{% endif %}{% if cookiecutter.with_shellcheck == 'true' %} && npm run lint:fix:shellcheck{% endif %}",
{%- if cookiecutter.action_type == 'node' %}
    "lint:fix:eslint": "eslint . --fix",
{%- endif %}
    "lint:fix:prettier": "prettier --write .",
{%- if cookiecutter.with_shellcheck == 'true' %}
    "lint:fix:shellcheck": "shellcheck **/*.sh --enable=all",
{%- endif %}
{%- if cookiecutter.action_type == 'node' %}
    "test": "vitest",
    "test:unit": "vitest tests/unit",
    "test:integration": "vitest tests/integration",
    "build": "tsc",
    "package": "rm -rf ./lib ./dist && npm run build && ncc build",
{%- endif %}
    "prepare": "husky"
  }
}
